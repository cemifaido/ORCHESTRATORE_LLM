# Dati runtime dell'orchestrazione: mai in Git.
dati_locali/
local/

# Snapshot di backup_locale.py: copie degli stessi dati locali sopra, stesso
# motivo per cui non vanno in Git.
backup_locale/
**/eventi.jsonl
**/events.jsonl
**/compiti/*.json
**/tasks/*.json
*.registro.md
*.ledger.md

# Istruzioni per assistenti AI (sincronizzazione multi-agente via registro):
# locali per operatore/macchina, non condivise nel repository.
CLAUDE.md
GEMINI.md
AGENTS.md

# Config hook/permessi degli strumenti AI: contengono percorsi assoluti e stato di
# sessioni reali di questa macchina, mai un template generico riusabile - locali
# per operatore/macchina, come CLAUDE.md/GEMINI.md/AGENTS.md sopra.
.claude/settings.json
.codex/
.gemini/
.agents/
# Config MCP del client Claude Code: percorsi assoluti di questa macchina.
# Il template riusabile e' config/mcp.esempio.json.
.mcp.json

# Attestazioni reali del catalogo capability (revisione Codex, 2026-08-26): il
# file versionato (capability_catalogo.esempio.json) descrive solo cosa il
# prodotto supporta in teoria; le attestazioni concrete (cosa e' stato
# verificato su QUESTA installazione, con quale configurazione di auth) sono
# dati locali, stesso principio di comandi.json/comandi.esempio.json.
config/capability_catalogo.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

