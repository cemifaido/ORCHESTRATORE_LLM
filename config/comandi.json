{
  "versione_schema": 1,
  "postino": {
    "max_turni_thread": 8,
    "max_invii_giorno": 10,
    "debounce_secondi": 300
  },
  "comandi": {
    "stato_git": {
      "descrizione": "Stato Git (git status --short)",
      "cartella": ".",
      "argomenti": [
        "git",
        "status",
        "--short"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 20000
    },
    "controllo_diff": {
      "descrizione": "Controllo Diff (git diff --check)",
      "cartella": ".",
      "argomenti": [
        "git",
        "diff",
        "--check"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 20000
    },
    "test_servizi": {
      "descrizione": "Test Servizi (unittest / pytest)",
      "cartella": ".",
      "argomenti": [
        "python",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "timeout_secondi": 300,
      "limite_output_caratteri": 60000
    },
    "controllo_salute": {
      "descrizione": "Salute Branch (git status --branch)",
      "cartella": ".",
      "argomenti": [
        "git",
        "status",
        "--branch",
        "--short"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 20000
    },
    "controllo_lint": {
      "descrizione": "Lint (ruff check)",
      "cartella": ".",
      "argomenti": [
        "python",
        "-m",
        "ruff",
        "check",
        "."
      ],
      "timeout_secondi": 60,
      "limite_output_caratteri": 40000
    },
    "controllo_tipi": {
      "descrizione": "Type check (mypy)",
      "cartella": ".",
      "argomenti": [
        "python",
        "-m",
        "mypy",
        "."
      ],
      "timeout_secondi": 120,
      "limite_output_caratteri": 40000
    },
    "controllo_complessita": {
      "descrizione": "Complessita (xenon)",
      "cartella": ".",
      "argomenti": [
        "python",
        "-m",
        "xenon",
        "--max-absolute", "C",
        "--max-modules", "B",
        "--max-average", "B",
        "."
      ],
      "timeout_secondi": 60,
      "limite_output_caratteri": 40000
    },
    "test_dashboard": {
      "descrizione": "Verifica stato Dashboard (TCP 8095)",
      "cartella": ".",
      "argomenti": [
        "python",
        "-c",
        "print('Dashboard online sulla porta 8095')"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 1000,
      "verifiche_connessione": [
        "http://localhost:8095"
      ]
    }
  }
}
