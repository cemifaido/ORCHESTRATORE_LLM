{
  "versione_schema": 1,
  "comandi": {
    "stato_git": {
      "cartella": ".",
      "argomenti": [
        "git",
        "status",
        "--short"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 20000
    },
    "controllo_diff": {
      "cartella": ".",
      "argomenti": [
        "git",
        "diff",
        "--check"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 20000
    },
    "test_servizi": {
      "cartella": ".",
      "argomenti": [
        "python",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "timeout_secondi": 300,
      "limite_output_caratteri": 60000
    },
    "controllo_salute": {
      "cartella": ".",
      "argomenti": [
        "git",
        "status",
        "--branch",
        "--short"
      ],
      "timeout_secondi": 30,
      "limite_output_caratteri": 20000
    }
  }
}
