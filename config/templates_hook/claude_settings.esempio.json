{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python bacheca.py prossimo --agente claude --formato hook --evento SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python bacheca.py prossimo --agente claude --formato hook --evento UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
